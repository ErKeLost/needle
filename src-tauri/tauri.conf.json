{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Needle",
  "version": "0.2.0",
  "identifier": "app.needle.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Needle",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#08070A",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/qishui/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "A vinyl-first music player",
    "longDescription": "Needle plays your files and NetEase Cloud Music as a record: one side at a time, with the words in time.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MUY5RTQyQjA4Q0NBRTIKUldUaXlveXdRcDRmTlhFTkhRMlhwalRVdWNlRHlkR0hxOUV4TEY0bG80U1Q5QTBEMGQrT21KUkYK",
      "endpoints": [
        "https://github.com/ErKeLost/needle/releases/latest/download/latest.json"
      ]
    }
  }
}